# Copiar a .env (`cp .env.example .env`). Valores solo para desarrollo local.

# Postgres en Docker. Se publica en 5433 para no chocar con un Postgres local.
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=gallinero
POSTGRES_TEST_DB=gallinero_test
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5433/gallinero
TEST_DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5433/gallinero_test

# Almacenamiento S3 local (RustFS). Consola en http://localhost:9001
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=catalog
S3_SECRET_KEY=catalog-secret
S3_REGION=us-east-1
S3_BUCKET=media
# Opcional: de dónde toma Next las fotos para /media/*. Por defecto, el bucket de arriba.
# MEDIA_INTERNAL_URL=http://localhost:9000/media

# URL con la que Next (servidor) llega a la API. El navegador nunca la usa:
# habla con Next y Next reenvía /api/* acá (ADR 0003).
API_INTERNAL_URL=http://localhost:8000

# URL pública del sitio, sin barra final. La usan la API (link del mensaje
# prearmado) y la web (Open Graph, canonical, sitemap y robots.txt). Para
# probar desde el celular en la misma red: SITE_URL=http://<ip-de-la-máquina>:3000
SITE_URL=http://localhost:3000

# Envío de emails (recuperar la contraseña, invitación, avisos) por SMTP genérico.
# En local van a Mailpit: los ves en http://localhost:8025 (no sale nada afuera).
# En producción, los datos del proveedor: SMTP_SECURITY=ssl (puerto 465) o
# starttls (puerto 587), con usuario y contraseña. El remitente va en config/store.toml.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=none
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# El e2e lee los emails de la API de Mailpit.
MAILPIT_URL=http://localhost:8025

# Admin de prueba que crea `make seed` (solo desarrollo). El e2e entra con él.
# Si ya existe, el seed no le cambia la contraseña.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-de-prueba
