# Copiar a .env (`cp .env.example .env`). Valores solo para desarrollo local.

# Postgres en Docker. Se publica en 5433 para no chocar con un Postgres local.
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=gallinero
POSTGRES_TEST_DB=gallinero_test
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5433/gallinero
TEST_DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5433/gallinero_test

# Almacenamiento S3 local (RustFS). Consola en http://localhost:9001
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=catalog
S3_SECRET_KEY=catalog-secret
S3_REGION=us-east-1
S3_BUCKET=media
# Opcional: de dónde toma Next las fotos para /media/*. Por defecto, el bucket de arriba.
# MEDIA_INTERNAL_URL=http://localhost:9000/media

# URL con la que Next (servidor) llega a la API. El navegador nunca la usa:
# habla con Next y Next reenvía /api/* acá (ADR 0003).
API_INTERNAL_URL=http://localhost:8000
