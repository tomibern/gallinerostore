{
  "name": "catalog",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.10.0"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,css,json}\""
  }
}
