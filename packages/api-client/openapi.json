{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalog API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/store": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Store",
        "operationId": "store_store_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicStore"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Products",
        "description": "Productos publicados del catálogo, en el orden manual.",
        "operationId": "list_products_products_get",
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Section"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Solo los productos de esa sección.",
              "title": "Section"
            },
            "description": "Solo los productos de esa sección."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductListItem"
                  },
                  "title": "Response List Products Products Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Availability": {
        "type": "string",
        "enum": [
          "in_stock",
          "on_order",
          "sold_out_on_order",
          "sold_out"
        ],
        "title": "Availability",
        "description": "Disponibilidad del producto de cara al cliente, ya calculada."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "Health"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database"
          },
          "storage": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Storage"
          }
        },
        "type": "object",
        "required": [
          "database",
          "storage"
        ],
        "title": "HealthChecks"
      },
      "ImageOut": {
        "properties": {
          "full": {
            "type": "string",
            "title": "Full",
            "description": "Ruta de la imagen completa (lado mayor 1600 px), bajo /media."
          },
          "thumb": {
            "type": "string",
            "title": "Thumb",
            "description": "Ruta de la miniatura (400 px), bajo /media."
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "full",
          "thumb",
          "alt",
          "width",
          "height"
        ],
        "title": "ImageOut"
      },
      "ProductListItem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Código permanente del producto: prefijo de la tienda y número (ABC-014)."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "price": {
            "type": "integer",
            "title": "Price",
            "description": "Precio en la unidad menor de la moneda (centavos)."
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "section": {
            "$ref": "#/components/schemas/Section",
            "description": "Sección donde aparece: un producto de stock agotado va a Por encargue."
          },
          "availability": {
            "$ref": "#/components/schemas/Availability",
            "description": "Disponibilidad de cara al cliente."
          },
          "cover": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "La primera imagen del producto, si tiene."
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "slug",
          "price",
          "currency",
          "section",
          "availability",
          "cover"
        ],
        "title": "ProductListItem"
      },
      "PublicStore": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "locale": {
            "type": "string",
            "title": "Locale"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "price_decimals": {
            "type": "integer",
            "title": "Price Decimals"
          },
          "collection_label": {
            "type": "string",
            "title": "Collection Label"
          },
          "features": {
            "$ref": "#/components/schemas/StoreFeatures"
          }
        },
        "type": "object",
        "required": [
          "name",
          "locale",
          "currency",
          "price_decimals",
          "collection_label",
          "features"
        ],
        "title": "PublicStore",
        "description": "Lo que la web necesita saber de la tienda. Nada secreto."
      },
      "Section": {
        "type": "string",
        "enum": [
          "stock",
          "on_order"
        ],
        "title": "Section",
        "description": "Sección del catálogo público. Se calcula, no se guarda: un producto de stock\nagotado aparece en Por encargue."
      },
      "StoreFeatures": {
        "properties": {
          "collections": {
            "type": "boolean",
            "title": "Collections",
            "default": true
          },
          "versions": {
            "type": "boolean",
            "title": "Versions",
            "default": true
          },
          "on_order": {
            "type": "boolean",
            "title": "On Order",
            "default": true
          },
          "instagram": {
            "type": "boolean",
            "title": "Instagram",
            "default": true
          },
          "metrics": {
            "type": "boolean",
            "title": "Metrics",
            "default": true
          },
          "product_story": {
            "type": "boolean",
            "title": "Product Story",
            "default": true
          }
        },
        "type": "object",
        "title": "StoreFeatures"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
