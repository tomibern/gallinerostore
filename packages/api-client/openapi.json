{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalog API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/store": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Store",
        "operationId": "store_store_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicStore"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Products",
        "description": "Productos publicados filtrados y ordenados, con los valores de filtro de la sección.",
        "operationId": "list_products_products_get",
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Section"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Solo los productos de esa sección.",
              "title": "Section"
            },
            "description": "Solo los productos de esa sección."
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de categoría. Una de nivel 1 incluye a sus hijas.",
              "default": [],
              "title": "Category"
            },
            "description": "Slugs de categoría. Una de nivel 1 incluye a sus hijas."
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de versión. Se ignora con las versiones apagadas.",
              "default": [],
              "title": "Version"
            },
            "description": "Slugs de versión. Se ignora con las versiones apagadas."
          },
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de colección. Se ignora con las colecciones apagadas.",
              "default": [],
              "title": "Collection"
            },
            "description": "Slugs de colección. Se ignora con las colecciones apagadas."
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de etiqueta.",
              "default": [],
              "title": "Tag"
            },
            "description": "Slugs de etiqueta."
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Etiquetas de talle disponible (en cualquier grupo de talles). Solo filtra en la sección En stock.",
              "default": [],
              "title": "Size"
            },
            "description": "Etiquetas de talle disponible (en cualquier grupo de talles). Solo filtra en la sección En stock."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ProductSort",
              "description": "Orden del listado.",
              "default": "manual"
            },
            "description": "Orden del listado."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Availability": {
        "type": "string",
        "enum": [
          "in_stock",
          "on_order",
          "sold_out_on_order",
          "sold_out"
        ],
        "title": "Availability",
        "description": "Disponibilidad del producto de cara al cliente, ya calculada."
      },
      "CategoryFacetValue": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Lo que se pasa en la query string: slug, o etiqueta de talle."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Productos con este valor, con los demás filtros aplicados (no el propio)."
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent",
            "description": "Slug de la categoría madre; null en las de nivel 1."
          }
        },
        "type": "object",
        "required": [
          "value",
          "name",
          "count",
          "parent"
        ],
        "title": "CategoryFacetValue"
      },
      "FacetValue": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Lo que se pasa en la query string: slug, o etiqueta de talle."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Productos con este valor, con los demás filtros aplicados (no el propio)."
          }
        },
        "type": "object",
        "required": [
          "value",
          "name",
          "count"
        ],
        "title": "FacetValue"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "Health"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database"
          },
          "storage": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Storage"
          }
        },
        "type": "object",
        "required": [
          "database",
          "storage"
        ],
        "title": "HealthChecks"
      },
      "ImageOut": {
        "properties": {
          "full": {
            "type": "string",
            "title": "Full",
            "description": "Ruta de la imagen completa (lado mayor 1600 px), bajo /media."
          },
          "thumb": {
            "type": "string",
            "title": "Thumb",
            "description": "Ruta de la miniatura (400 px), bajo /media."
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "full",
          "thumb",
          "alt",
          "width",
          "height"
        ],
        "title": "ImageOut"
      },
      "ProductFacets": {
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategoryFacetValue"
            },
            "type": "array",
            "title": "Categories",
            "description": "En orden de árbol: cada categoría de nivel 1 seguida de sus hijas."
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Versions",
            "description": "Vacía con las versiones apagadas."
          },
          "collections": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Collections",
            "description": "Vacía con las colecciones apagadas o con una sola colección cargada."
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Tags"
          },
          "sizes": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Sizes",
            "description": "Solo en la sección En stock."
          }
        },
        "type": "object",
        "required": [
          "categories",
          "versions",
          "collections",
          "tags",
          "sizes"
        ],
        "title": "ProductFacets",
        "description": "Valores con resultados en la sección. Una lista vacía es un filtro que no se muestra."
      },
      "ProductList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProductListItem"
            },
            "type": "array",
            "title": "Items"
          },
          "facets": {
            "$ref": "#/components/schemas/ProductFacets"
          }
        },
        "type": "object",
        "required": [
          "items",
          "facets"
        ],
        "title": "ProductList"
      },
      "ProductListItem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Código permanente del producto: prefijo de la tienda y número (ABC-014)."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "price": {
            "type": "integer",
            "title": "Price",
            "description": "Precio en la unidad menor de la moneda (centavos)."
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "section": {
            "$ref": "#/components/schemas/Section",
            "description": "Sección donde aparece: un producto de stock agotado va a Por encargue."
          },
          "availability": {
            "$ref": "#/components/schemas/Availability",
            "description": "Disponibilidad de cara al cliente."
          },
          "cover": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "La primera imagen del producto, si tiene."
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "slug",
          "price",
          "currency",
          "section",
          "availability",
          "cover"
        ],
        "title": "ProductListItem"
      },
      "ProductSort": {
        "type": "string",
        "enum": [
          "manual",
          "newest",
          "price_asc",
          "price_desc"
        ],
        "title": "ProductSort",
        "description": "Orden del listado. ``manual`` es el que el visitante ve como «Destacados»."
      },
      "PublicStore": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "locale": {
            "type": "string",
            "title": "Locale"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "price_decimals": {
            "type": "integer",
            "title": "Price Decimals"
          },
          "collection_label": {
            "type": "string",
            "title": "Collection Label"
          },
          "features": {
            "$ref": "#/components/schemas/StoreFeatures"
          }
        },
        "type": "object",
        "required": [
          "name",
          "locale",
          "currency",
          "price_decimals",
          "collection_label",
          "features"
        ],
        "title": "PublicStore",
        "description": "Lo que la web necesita saber de la tienda. Nada secreto."
      },
      "Section": {
        "type": "string",
        "enum": [
          "stock",
          "on_order"
        ],
        "title": "Section",
        "description": "Sección del catálogo público. Se calcula, no se guarda: un producto de stock\nagotado aparece en Por encargue."
      },
      "StoreFeatures": {
        "properties": {
          "collections": {
            "type": "boolean",
            "title": "Collections",
            "default": true
          },
          "versions": {
            "type": "boolean",
            "title": "Versions",
            "default": true
          },
          "on_order": {
            "type": "boolean",
            "title": "On Order",
            "default": true
          },
          "instagram": {
            "type": "boolean",
            "title": "Instagram",
            "default": true
          },
          "metrics": {
            "type": "boolean",
            "title": "Metrics",
            "default": true
          },
          "product_story": {
            "type": "boolean",
            "title": "Product Story",
            "default": true
          }
        },
        "type": "object",
        "title": "StoreFeatures"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
