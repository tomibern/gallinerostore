{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalog API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/store": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Store",
        "description": "Configuración pública de la tienda: los bloques de la home con sus fotos, «Cómo\ncomprar», las preguntas frecuentes, los canales activos y la consulta general.",
        "operationId": "store_store_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicStore"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Products",
        "description": "Productos publicados filtrados y ordenados, con los valores de filtro de la sección.",
        "operationId": "list_products_products_get",
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Section"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Solo los productos de esa sección.",
              "title": "Section"
            },
            "description": "Solo los productos de esa sección."
          },
          {
            "name": "featured",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Solo los destacados (los de la home). Con false no filtra.",
              "default": false,
              "title": "Featured"
            },
            "description": "Solo los destacados (los de la home). Con false no filtra."
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de categoría. Una de nivel 1 incluye a sus hijas.",
              "default": [],
              "title": "Category"
            },
            "description": "Slugs de categoría. Una de nivel 1 incluye a sus hijas."
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de versión. Se ignora con las versiones apagadas.",
              "default": [],
              "title": "Version"
            },
            "description": "Slugs de versión. Se ignora con las versiones apagadas."
          },
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de colección. Se ignora con las colecciones apagadas.",
              "default": [],
              "title": "Collection"
            },
            "description": "Slugs de colección. Se ignora con las colecciones apagadas."
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de etiqueta.",
              "default": [],
              "title": "Tag"
            },
            "description": "Slugs de etiqueta."
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Etiquetas de talle disponible (en cualquier grupo de talles). Solo filtra en la sección En stock.",
              "default": [],
              "title": "Size"
            },
            "description": "Etiquetas de talle disponible (en cualquier grupo de talles). Solo filtra en la sección En stock."
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Búsqueda por nombre o código, sin distinguir mayúsculas ni acentos. Cada palabra tiene que aparecer en el nombre o en el código.",
              "title": "Q"
            },
            "description": "Búsqueda por nombre o código, sin distinguir mayúsculas ni acentos. Cada palabra tiene que aparecer en el nombre o en el código."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ProductSort",
              "description": "Orden del listado.",
              "default": "manual"
            },
            "description": "Orden del listado."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Cuántos productos traer como máximo.",
              "default": 20,
              "title": "Limit"
            },
            "description": "Cuántos productos traer como máximo."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Cuántos productos saltear desde el inicio.",
              "default": 0,
              "title": "Offset"
            },
            "description": "Cuántos productos saltear desde el inicio."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/products/{code}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get Product",
        "description": "Detalle de un producto publicado. El código no distingue mayúsculas (abc-014 = ABC-014).",
        "operationId": "get_product_products__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetail"
                }
              }
            }
          },
          "404": {
            "description": "No hay un producto publicado con ese código."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Record Event",
        "description": "Registra una visita o una consulta, sin cookies ni datos personales. La IP solo\ncuenta para el límite de frecuencia: no se guarda.",
        "operationId": "record_event_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/PageView"
                  },
                  {
                    "$ref": "#/components/schemas/ProductView"
                  },
                  {
                    "$ref": "#/components/schemas/ContactClick"
                  },
                  {
                    "$ref": "#/components/schemas/GeneralContactClick"
                  }
                ],
                "title": "Event",
                "discriminator": {
                  "propertyName": "type",
                  "mapping": {
                    "page_view": "#/components/schemas/PageView",
                    "product_view": "#/components/schemas/ProductView",
                    "contact_click": "#/components/schemas/ContactClick",
                    "general_contact_click": "#/components/schemas/GeneralContactClick"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "429": {
            "description": "Demasiados eventos desde la misma IP."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/session": {
      "post": {
        "tags": [
          "admin-auth"
        ],
        "summary": "Log In",
        "description": "Abre una sesión y pone la cookie. El error no dice si falló el email o la contraseña.",
        "operationId": "log_in_admin_session_post",
        "parameters": [
          {
            "name": "X-Requested-With",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Requested-With"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOut"
                }
              }
            }
          },
          "401": {
            "description": "Email o contraseña incorrectos."
          },
          "429": {
            "description": "Demasiados intentos fallidos: hay que esperar 15 minutos."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "admin-auth"
        ],
        "summary": "Current Admin",
        "description": "El admin de la sesión actual.",
        "operationId": "current_admin_admin_session_get",
        "parameters": [
          {
            "name": "admin_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Admin Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOut"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión vigente."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "admin-auth"
        ],
        "summary": "Log Out",
        "description": "Corta la sesión (si había) y borra la cookie.",
        "operationId": "log_out_admin_session_delete",
        "parameters": [
          {
            "name": "X-Requested-With",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Requested-With"
            }
          },
          {
            "name": "admin_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Admin Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminOut": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "AdminOut"
      },
      "Availability": {
        "type": "string",
        "enum": [
          "in_stock",
          "on_order",
          "sold_out_on_order",
          "sold_out"
        ],
        "title": "Availability",
        "description": "Disponibilidad del producto de cara al cliente, ya calculada."
      },
      "CategoryFacetValue": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Lo que se pasa en la query string: slug, o etiqueta de talle."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Productos con este valor, con los demás filtros aplicados (no el propio)."
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent",
            "description": "Slug de la categoría madre; null en las de nivel 1."
          }
        },
        "type": "object",
        "required": [
          "value",
          "name",
          "count",
          "parent"
        ],
        "title": "CategoryFacetValue"
      },
      "Channel": {
        "type": "string",
        "enum": [
          "whatsapp",
          "instagram"
        ],
        "title": "Channel",
        "description": "Canal de contacto: por donde se consulta (y se registra la consulta)."
      },
      "ContactClick": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Session Id"
          },
          "source": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Source"
          },
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "type": {
            "type": "string",
            "const": "contact_click",
            "title": "Type"
          },
          "product_code": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Product Code"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "size": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Size"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "source",
          "device",
          "type",
          "product_code",
          "channel",
          "size"
        ],
        "title": "ContactClick",
        "description": "Consulta por un producto: se tocó el link que abre el chat."
      },
      "Device": {
        "type": "string",
        "enum": [
          "mobile",
          "desktop"
        ],
        "title": "Device",
        "description": "Por el ancho de la pantalla, no por el modelo ni el navegador."
      },
      "FacetValue": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Lo que se pasa en la query string: slug, o etiqueta de talle."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Productos con este valor, con los demás filtros aplicados (no el propio)."
          }
        },
        "type": "object",
        "required": [
          "value",
          "name",
          "count"
        ],
        "title": "FacetValue"
      },
      "FaqItem": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question",
            "description": "El texto del encabezado, sin los #."
          },
          "answer_md": {
            "type": "string",
            "title": "Answer Md",
            "description": "La respuesta, en Markdown."
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer_md"
        ],
        "title": "FaqItem",
        "description": "Una pregunta frecuente: cada encabezado ``##`` de las preguntas abre una."
      },
      "GeneralContactClick": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Session Id"
          },
          "source": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Source"
          },
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "type": {
            "type": "string",
            "const": "general_contact_click",
            "title": "Type"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "source",
          "device",
          "type",
          "channel",
          "page"
        ],
        "title": "GeneralContactClick",
        "description": "Consulta general: se tocó el link que abre el chat, desde esa página."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "Health"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database"
          },
          "storage": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Storage"
          }
        },
        "type": "object",
        "required": [
          "database",
          "storage"
        ],
        "title": "HealthChecks"
      },
      "HomeBlock": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key",
            "description": "Clave del bloque, declarada en la configuración de la tienda."
          },
          "slides": {
            "items": {
              "$ref": "#/components/schemas/HomeSlideOut"
            },
            "type": "array",
            "title": "Slides",
            "description": "Hasta 4 fotos, en su orden. Vacía si el bloque todavía no tiene fotos."
          }
        },
        "type": "object",
        "required": [
          "key",
          "slides"
        ],
        "title": "HomeBlock",
        "description": "Un bloque con carrusel de la home. Sus textos salen del diccionario de la web\n(``home.blocks.<key>.*``); la API solo da la clave y las fotos."
      },
      "HomeSlideOut": {
        "properties": {
          "full": {
            "type": "string",
            "title": "Full",
            "description": "Ruta de la foto (lado mayor 1600 px), bajo /media."
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          }
        },
        "type": "object",
        "required": [
          "full",
          "alt"
        ],
        "title": "HomeSlideOut"
      },
      "ImageOut": {
        "properties": {
          "full": {
            "type": "string",
            "title": "Full",
            "description": "Ruta de la imagen completa (lado mayor 1600 px), bajo /media."
          },
          "thumb": {
            "type": "string",
            "title": "Thumb",
            "description": "Ruta de la miniatura (400 px), bajo /media."
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "full",
          "thumb",
          "alt",
          "width",
          "height"
        ],
        "title": "ImageOut"
      },
      "Inquiry": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "El mensaje prearmado, ya armado."
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "WhatsApp: wa.me con el mensaje en el texto. Instagram: el chat (ig.me) sin texto, porque no lo acepta; el mensaje se muestra aparte para copiarlo."
          }
        },
        "type": "object",
        "required": [
          "channel",
          "message",
          "url"
        ],
        "title": "Inquiry",
        "description": "Una consulta lista para usar: el mensaje prearmado y el link que abre el chat."
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "title": "Password"
          },
          "remember": {
            "type": "boolean",
            "title": "Remember",
            "description": "«Mantener la sesión iniciada»: 30 días renovables en vez de hasta cerrar el navegador.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "NamedRef": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name"
        ],
        "title": "NamedRef"
      },
      "Page": {
        "type": "string",
        "enum": [
          "home",
          "stock",
          "on_order",
          "how_to_buy",
          "product",
          "not_found"
        ],
        "title": "Page",
        "description": "Página de una visita o de una consulta general. Identificadores estables, no las\nrutas: cambiar una ruta no rompe las métricas."
      },
      "PageView": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Session Id"
          },
          "source": {
