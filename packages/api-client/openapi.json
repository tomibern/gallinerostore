{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalog API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/store": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Store",
        "description": "Configuración pública de la tienda: los bloques de la home con sus fotos, «Cómo\ncomprar», las preguntas frecuentes, los canales activos y la consulta general.",
        "operationId": "store_store_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicStore"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Products",
        "description": "Productos publicados filtrados y ordenados, con los valores de filtro de la sección.",
        "operationId": "list_products_products_get",
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Section"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Solo los productos de esa sección.",
              "title": "Section"
            },
            "description": "Solo los productos de esa sección."
          },
          {
            "name": "featured",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Solo los destacados (los de la home). Con false no filtra.",
              "default": false,
              "title": "Featured"
            },
            "description": "Solo los destacados (los de la home). Con false no filtra."
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de categoría. Una de nivel 1 incluye a sus hijas.",
              "default": [],
              "title": "Category"
            },
            "description": "Slugs de categoría. Una de nivel 1 incluye a sus hijas."
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de versión. Se ignora con las versiones apagadas.",
              "default": [],
              "title": "Version"
            },
            "description": "Slugs de versión. Se ignora con las versiones apagadas."
          },
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de colección. Se ignora con las colecciones apagadas.",
              "default": [],
              "title": "Collection"
            },
            "description": "Slugs de colección. Se ignora con las colecciones apagadas."
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Slugs de etiqueta.",
              "default": [],
              "title": "Tag"
            },
            "description": "Slugs de etiqueta."
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Etiquetas de talle disponible (en cualquier grupo de talles). Solo filtra en la sección En stock.",
              "default": [],
              "title": "Size"
            },
            "description": "Etiquetas de talle disponible (en cualquier grupo de talles). Solo filtra en la sección En stock."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ProductSort",
              "description": "Orden del listado.",
              "default": "manual"
            },
            "description": "Orden del listado."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Cuántos productos traer como máximo.",
              "default": 20,
              "title": "Limit"
            },
            "description": "Cuántos productos traer como máximo."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Cuántos productos saltear desde el inicio.",
              "default": 0,
              "title": "Offset"
            },
            "description": "Cuántos productos saltear desde el inicio."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/products/{code}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get Product",
        "description": "Detalle de un producto publicado. El código no distingue mayúsculas (abc-014 = ABC-014).",
        "operationId": "get_product_products__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetail"
                }
              }
            }
          },
          "404": {
            "description": "No hay un producto publicado con ese código."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Availability": {
        "type": "string",
        "enum": [
          "in_stock",
          "on_order",
          "sold_out_on_order",
          "sold_out"
        ],
        "title": "Availability",
        "description": "Disponibilidad del producto de cara al cliente, ya calculada."
      },
      "CategoryFacetValue": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Lo que se pasa en la query string: slug, o etiqueta de talle."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Productos con este valor, con los demás filtros aplicados (no el propio)."
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent",
            "description": "Slug de la categoría madre; null en las de nivel 1."
          }
        },
        "type": "object",
        "required": [
          "value",
          "name",
          "count",
          "parent"
        ],
        "title": "CategoryFacetValue"
      },
      "Channel": {
        "type": "string",
        "enum": [
          "whatsapp",
          "instagram"
        ],
        "title": "Channel",
        "description": "Canal de contacto: por donde se consulta (y se registra la consulta)."
      },
      "FacetValue": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Lo que se pasa en la query string: slug, o etiqueta de talle."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Productos con este valor, con los demás filtros aplicados (no el propio)."
          }
        },
        "type": "object",
        "required": [
          "value",
          "name",
          "count"
        ],
        "title": "FacetValue"
      },
      "FaqItem": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question",
            "description": "El texto del encabezado, sin los #."
          },
          "answer_md": {
            "type": "string",
            "title": "Answer Md",
            "description": "La respuesta, en Markdown."
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer_md"
        ],
        "title": "FaqItem",
        "description": "Una pregunta frecuente: cada encabezado ``##`` de las preguntas abre una."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "Health"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database"
          },
          "storage": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Storage"
          }
        },
        "type": "object",
        "required": [
          "database",
          "storage"
        ],
        "title": "HealthChecks"
      },
      "HomeBlock": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key",
            "description": "Clave del bloque, declarada en la configuración de la tienda."
          },
          "slides": {
            "items": {
              "$ref": "#/components/schemas/HomeSlideOut"
            },
            "type": "array",
            "title": "Slides",
            "description": "Hasta 4 fotos, en su orden. Vacía si el bloque todavía no tiene fotos."
          }
        },
        "type": "object",
        "required": [
          "key",
          "slides"
        ],
        "title": "HomeBlock",
        "description": "Un bloque con carrusel de la home. Sus textos salen del diccionario de la web\n(``home.blocks.<key>.*``); la API solo da la clave y las fotos."
      },
      "HomeSlideOut": {
        "properties": {
          "full": {
            "type": "string",
            "title": "Full",
            "description": "Ruta de la foto (lado mayor 1600 px), bajo /media."
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          }
        },
        "type": "object",
        "required": [
          "full",
          "alt"
        ],
        "title": "HomeSlideOut"
      },
      "ImageOut": {
        "properties": {
          "full": {
            "type": "string",
            "title": "Full",
            "description": "Ruta de la imagen completa (lado mayor 1600 px), bajo /media."
          },
          "thumb": {
            "type": "string",
            "title": "Thumb",
            "description": "Ruta de la miniatura (400 px), bajo /media."
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "full",
          "thumb",
          "alt",
          "width",
          "height"
        ],
        "title": "ImageOut"
      },
      "Inquiry": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "El mensaje prearmado, ya armado."
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "WhatsApp: wa.me con el mensaje en el texto. Instagram: el chat (ig.me) sin texto, porque no lo acepta; el mensaje se muestra aparte para copiarlo."
          }
        },
        "type": "object",
        "required": [
          "channel",
          "message",
          "url"
        ],
        "title": "Inquiry",
        "description": "Una consulta lista para usar: el mensaje prearmado y el link que abre el chat."
      },
      "NamedRef": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name"
        ],
        "title": "NamedRef"
      },
      "ProductDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Código permanente del producto: prefijo de la tienda y número (ABC-014)."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "price": {
            "type": "integer",
            "title": "Price",
            "description": "Precio en la unidad menor de la moneda (centavos)."
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "section": {
            "$ref": "#/components/schemas/Section",
            "description": "Sección donde aparece: un producto de stock agotado va a Por encargue."
          },
          "availability": {
            "$ref": "#/components/schemas/Availability",
            "description": "Disponibilidad de cara al cliente."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "season": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Season"
          },
          "category": {
            "$ref": "#/components/schemas/NamedRef",
            "description": "La categoría asignada (puede ser de nivel 2)."
          },
          "version": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NamedRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null sin versión o con las versiones apagadas."
          },
          "collection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NamedRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null con las colecciones apagadas."
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageOut"
            },
            "type": "array",
            "title": "Images",
            "description": "En orden: la primera es la portada."
          },
          "sizes": {
            "items": {
              "$ref": "#/components/schemas/ProductSizeOut"
            },
            "type": "array",
            "title": "Sizes",
            "description": "En el orden del grupo de talles. En stock, los del producto; en un encargue o un agotado que pasó a encargue, todos los del grupo de su categoría."
          },
          "on_order_notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "On Order Notice",
            "description": "Aviso de encargue que edita el admin. Solo en un encargue o un agotado que pasó a encargue, y null si no está cargado."
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "slug",
          "price",
          "currency",
          "section",
          "availability",
          "description",
          "season",
          "category",
          "version",
          "collection",
          "images",
          "sizes",
          "on_order_notice"
        ],
        "title": "ProductDetail"
      },
      "ProductFacets": {
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategoryFacetValue"
            },
            "type": "array",
            "title": "Categories",
            "description": "En orden de árbol: cada categoría de nivel 1 seguida de sus hijas."
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Versions",
            "description": "Vacía con las versiones apagadas."
          },
          "collections": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Collections",
            "description": "Vacía con las colecciones apagadas o con una sola colección cargada."
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Tags"
          },
          "sizes": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Sizes",
            "description": "Solo en la sección En stock."
          }
        },
        "type": "object",
        "required": [
          "categories",
          "versions",
          "collections",
          "tags",
          "sizes"
        ],
        "title": "ProductFacets",
        "description": "Valores con resultados en la sección. Una lista vacía es un filtro que no se muestra."
      },
      "ProductList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProductListItem"
            },
            "type": "array",
            "title": "Items",
            "description": "La página pedida."
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More",
            "description": "Si hay más productos después de esta página."
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Productos que cumplen los filtros, en todas las páginas."
          },
          "facets": {
            "$ref": "#/components/schemas/ProductFacets",
            "description": "Calculadas sobre todo el listado filtrado, no sobre la página."
          }
        },
        "type": "object",
        "required": [
          "items",
          "has_more",
          "total",
          "facets"
        ],
        "title": "ProductList"
      },
      "ProductListItem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Código permanente del producto: prefijo de la tienda y número (ABC-014)."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "price": {
            "type": "integer",
            "title": "Price",
            "description": "Precio en la unidad menor de la moneda (centavos)."
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "section": {
            "$ref": "#/components/schemas/Section",
            "description": "Sección donde aparece: un producto de stock agotado va a Por encargue."
          },
          "availability": {
            "$ref": "#/components/schemas/Availability",
            "description": "Disponibilidad de cara al cliente."
          },
          "cover": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "La primera imagen del producto, si tiene."
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "slug",
          "price",
          "currency",
          "section",
          "availability",
          "cover"
        ],
        "title": "ProductListItem"
      },
      "ProductSizeOut": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "status": {
            "$ref": "#/components/schemas/SizeStatus",
            "description": "in_stock y out_of_stock en un producto de stock (sin stock se muestra tachado, pero se puede elegir); on_order en un encargue o un agotado que pasó a encargue."
          },
          "inquiries": {
            "items": {
              "$ref": "#/components/schemas/Inquiry"
            },
            "type": "array",
            "title": "Inquiries",
            "description": "La consulta por este talle, una por canal ofrecido (WhatsApp primero), con el mensaje y el link ya armados. Vacía si la tienda no cargó canales."
          }
        },
        "type": "object",
        "required": [
          "label",
          "status",
          "inquiries"
        ],
        "title": "ProductSizeOut"
      },
      "ProductSort": {
        "type": "string",
        "enum": [
          "manual",
          "newest",
          "price_asc",
          "price_desc"
        ],
        "title": "ProductSort",
        "description": "Orden del listado. ``manual`` es el que el visitante ve como «Destacados»."
      },
      "PublicStore": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "locale": {
            "type": "string",
            "title": "Locale"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "price_decimals": {
            "type": "integer",
            "title": "Price Decimals"
          },
          "collection_label": {
            "type": "string",
            "title": "Collection Label"
          },
          "features": {
            "$ref": "#/components/schemas/StoreFeatures"
          },
          "home_blocks": {
            "items": {
              "$ref": "#/components/schemas/HomeBlock"
            },
            "type": "array",
            "title": "Home Blocks",
            "description": "Bloques con carrusel de la home, en el orden de la configuración."
          },
          "channels": {
            "items": {
              "$ref": "#/components/schemas/Channel"
            },
            "type": "array",
            "title": "Channels",
            "description": "Canales de contacto activos, en el orden en que se ofrecen."
          },
          "general_inquiries": {
            "items": {
              "$ref": "#/components/schemas/Inquiry"
            },
            "type": "array",
            "title": "General Inquiries",
            "description": "La consulta general (sin producto), una por canal activo."
          },
          "on_order_notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "On Order Notice",
            "description": "El aviso de demora de los productos por encargue, si la tienda lo cargó."
          },
          "how_to_buy_md": {
            "type": "string",
